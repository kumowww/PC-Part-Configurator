from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import Select
import os
import time

def test_compatibility():
    driver = webdriver.Chrome()
    file_path = "file://" + os.path.abspath("index.html")

    try:
        driver.get(file_path)
        time.sleep(2)

        model_select = Select(driver.find_element(By.ID, "cpu-model-select"))
        model_select.select_by_visible_text("Ryzen 5 7600")
        time.sleep(1)

        suffix_select = Select(driver.find_element(By.ID, "cpu-suffix-select"))
        suffix_select.select_by_index(0)

        mobo_select = Select(driver.find_element(By.ID, "mobo-select"))
        mobo_select.select_by_index(1)

        driver.find_element(By.TAG_NAME, "button").click()
        time.sleep(1)

        result_text = driver.find_element(By.ID, "result").text
        if "Incompatible" in result_text:
            print("GUI Test Passed: Incompatibility detected correctly.")
            assert "Incompatible" in result_text
        else:
            print("GUI Test Failed: Compatibility logic error.")
            assert False, "Expected incompatibility not detected."

    finally:
        driver.quit()

if __name__ == "__main__":
    test_compatibility()